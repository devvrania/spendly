# Local: the browser calls the API directly. Use "localhost" (not 127.0.0.1)
# for both apps so the session cookie is shared.
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Production (e.g. Vercel): proxy the API through the web app's own domain so
# the session cookie is first-party.
# NEXT_PUBLIC_API_URL="/api/v1"
# API_PROXY_TARGET="https://your-api-host.example.com"
