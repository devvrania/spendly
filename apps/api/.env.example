NODE_ENV=development
PORT=4000
# Local Docker Postgres (see docker-compose.yml). For Neon, use the pooled URL here
# and the direct (non-pooled) URL in DIRECT_URL so migrations bypass PgBouncer.
DATABASE_URL="postgresql://spendly:spendly@localhost:5434/spendly_dev?schema=public"
DIRECT_URL="postgresql://spendly:spendly@localhost:5434/spendly_dev?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
# No refresh tokens in the MVP, so the session lasts as long as this token.
JWT_ACCESS_EXPIRES_IN="1d"
FRONTEND_URL="http://localhost:3000"

# --- Production / hosting ---
# Number of proxy hops in front of the API, so rate limiting sees the real visitor
# IP. Vercel rewrite -> Render is typically 2 (Vercel edge + Render load
# balancer); confirm against your host's docs.
# Leave empty locally.
TRUST_PROXY=
# API docs at /api/docs are on in development and off in production unless "true".
SWAGGER_ENABLED=
